# ─── Telethon — חשבון משתמש ייעודי לפרסום ───────────────────────────────────
# קבל מ-https://my.telegram.org (Apps)
TELE_API_ID=
TELE_API_HASH=
TELE_PHONE=           # מספר בינלאומי: +972501234567

# ─── Admin — לפקודות ניהול דרך הבוט ─────────────────────────────────────────
BOT_TOKEN=8552909506:AAH3zZIyHnj9nriHxG_UOLmkkly_7kBrDqA
ADMIN_ID=8235527820

# ─── לימיטים יומיים ───────────────────────────────────────────────────────────
MAX_NEW_GROUPS_PER_DAY=5       # כמה קבוצות חדשות לגלות ביום
DAILY_POST_LIMIT=8             # מקסימום פוסטים ביום סה"כ
POST_COOLDOWN_DAYS=7           # ימי המתנה בין פוסטים לאותה קבוצה

# ─── תזמון (שעון ישראל) ───────────────────────────────────────────────────────
MIN_DELAY_MINUTES=25           # המתנה מינימלית בין פוסטים
MAX_DELAY_MINUTES=55           # המתנה מקסימלית בין פוסטים
ACTIVE_HOUR_START=10           # שעת התחלה
ACTIVE_HOUR_END=21             # שעת סיום

# ─── פילטר קבוצות ────────────────────────────────────────────────────────────
MIN_GROUP_MEMBERS=150          # מינימום חברים בקבוצה
MAX_GROUP_MEMBERS=50000        # מקסימום חברים בקבוצה

# ─── Instagram Agent ──────────────────────────────────────────────────────────
# ⚠️  הרצה ראשונה: instagrapi שולח checkpoint (אימות SMS/אימייל).
#     הרץ   python -m ig.main   פעם ראשונה ידנית — עקוב אחר ההוראות בטרמינל.
#     לאחר הצלחה נוצר ig_session.json — נשמר אוטומטית לכל הרצות הבאות.
IG_USERNAME=
IG_PASSWORD=
DAILY_IG_DM_LIMIT=15           # הודעות DM ביום (מומלץ להתחיל מ-10)
DAILY_IG_FOLLOW_LIMIT=20       # עקיבות ביום

# ─── Instagram Graph API (עמוד עסקי — אופציונלי אך מומלץ) ────────────────────
# מאפשר: פרסום Reels רשמי + Analytics (/iginsights) + Insights
# שלב 1: developers.facebook.com → צור App מסוג "Business"
# שלב 2: הוסף מוצר "Instagram Graph API"
# שלב 3: Graph API Explorer → בחר את האפליקציה שלך → Generate Token
#         הרשאות נדרשות: instagram_basic, instagram_content_publish,
#                        instagram_manage_insights, pages_read_engagement
# שלב 4: העתק את ה-User ID של חשבון האינסטגרם העסקי שלך
IG_ACCESS_TOKEN=               # Long-lived access token (תוקף 60 יום, ניתן לחידוש)
IG_BUSINESS_ACCOUNT_ID=        # מספר ה-ID של חשבון האינסטגרם העסקי

# ─── Facebook Agent ───────────────────────────────────────────────────────────
# ⚠️  הרצה ראשונה: Playwright פותח דפדפן אמיתי — ייתכן שתצטרך לאשר 2FA ידנית.
#     לאחר ההתחברות נשמרים fb_cookies.json — בהרצות הבאות מתחבר אוטומטית.
#     אם נחסם: מחק fb_cookies.json והתחבר מחדש.
FB_EMAIL=
FB_PASSWORD=
DAILY_FB_POST_LIMIT=5          # פוסטים בקבוצות ביום
DAILY_FB_COMMENT_LIMIT=10      # תגובות ביום

# ─── TikTok Agent ─────────────────────────────────────────────────────────────
# ⚠️  הרצה ראשונה: TikTok דורש CAPTCHA — פתח Playwright ב-headful mode לפתרון ידני.
#     לאחר פתרון CAPTCHA נשמרים tt_cookies.json — בהרצות הבאות אוטומטי.
# ⚠️  TikTok מחמיר מאוד — הגדרות ברירת מחדל שמרניות.
#     אל תעלה לימיטים לפני שבוע–שבועיים של פעילות רגילה.
TT_USERNAME=
TT_PASSWORD=
DAILY_TT_COMMENT_LIMIT=23      # תגובות ביום (ברירת מחדל: 23)
DAILY_TT_FOLLOW_LIMIT=20       # עקיבות ביום (ברירת מחדל: 20)

# ─── AI Provider — מנוע בינה מלאכותית (3 שכבות) ──────────────────────────────
# שכבה 1: Ollama (מקומי, חינם לגמרי)
# הורד מ-ollama.com/download, הרץ: ollama pull llama3.2:3b
# אם יש Cloudflare Tunnel — שים את ה-URL שלו; אחרת השאר http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SECRET=                         # סוד Cloudflare Header Auth (ריק אם מקומי)
OLLAMA_MODEL=llama3.2:3b               # המודל המומלץ: llama3.2:3b (מהיר, 2GB)

# שכבה 2: Gemini Flash (חינם עד 1M tokens/month)
# קבל מפתח API מ-aistudio.google.com → Get API Key
GEMINI_API_KEY=

# ─── Competitor Infiltrator Agent (CI) ────────────────────────────────────────
# רשימות username מופרדות בפסיק (ללא @)
CI_COMPETITORS_TG=                     # channels מתחרים בטלגרם: @competitor1,@competitor2
CI_COMPETITORS_IG=                     # חשבונות מתחרים באינסטגרם: username1,username2
DAILY_CI_DM_LIMIT=8                   # מקסימום DMs ביום על ידי CI agent
CI_SCAN_INTERVAL_HOURS=3              # כל כמה שעות לסרוק מתחרים

# ─── Account Warmer ────────────────────────────────────────────────────────────
# פרוטוקול חימום לפני כל session שיווקי (80% human / 20% marketing)
WARM_INTENSITY=medium                  # low / medium / high
WARM_BEFORE_SESSION=true               # true = חמם לפני כל session
